          "format": "table",
          "rawSql": "SELECT\n    s.asset_uid AS asset_uid,\n    toFloat64OrNaN(JSONExtractString(s.payload, 'profitability', 'units'))\n      + toFloat64OrNaN(JSONExtractString(s.payload, 'profitability', 'nano')) / 1e9 AS pe\nFROM (\n    SELECT asset_uid, argMax(payload, snapshot_ts) AS payload\n    FROM market_data.fundamentals_snapshots\n    GROUP BY asset_uid\n) AS s\nORDER BY s.asset_uid",
