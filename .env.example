# ============================================================================
# MarketDataGrabber — шаблон переменных окружения.
#
# КАК ПОЛЬЗОВАТЬСЯ:
#   1. cp .env.example .env
#   2. Заполнить значения.
#   3. .env НИКОГДА не попадает в git (уже в .gitignore), chmod 600.
# Секреты не хранить нигде больше: не в коде, не в docker-compose.yml,
# не в Obsidian, не в логах (логгер маскирует значения автоматически).
# ============================================================================

# --- T-Invest API -----------------------------------------------------------
# Токен с правом "чтение" (портфель без сделок) — коллекторы, архивы, фундаментал.
# Создать: Т-Инвестиции -> Настройки -> Подтверждённый токен.
T_INVEST_READ_TOKEN=

# Trade-токен — НЕ создавать до фазы P6 (полуавтоматические сделки).
T_INVEST_TRADE_TOKEN=

# Токен песочницы (paper trading) — опционально, фаза P6.
T_INVEST_SANDBOX_TOKEN=

# --- Telegram ----------------------------------------------------------------
# Токен бота проекта от @BotFather (НЕ токен бота Hermes).
TELEGRAM_BOT_TOKEN=

# Личный chat_id администратора (все ops-алерты идут только сюда).
# Узнать: написать боту /start, id придёт в лог первого сообщения.
ADMIN_CHAT_ID=

# --- ClickHouse --------------------------------------------------------------
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_PORT=8123
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# --- Grafana -----------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# --- Общие -------------------------------------------------------------------
# Часовой пояс бизнес-логики (MOEX работает в MSK).
TZ=Europe/Moscow
LOG_LEVEL=INFO

# IP хоста на docker-мосту для бинда портов (127.0.0.1 если клиент на самом хосте)
#CH_BIND_IP=172.18.0.1
CLICKHOUSE_HOST=127.0.0.1

# Локальные адреса не должны ходить через прокси
NO_PROXY=127.0.0.1,localhost,172.18.0.1
